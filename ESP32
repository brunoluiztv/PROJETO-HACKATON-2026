#include <Arduino.h>
#include <ctype.h>
#include <math.h>

/*
  AGUA NO PONTO — prova de conceito para ESP32 DevKit classico

  Importante: o higrometro resistivo fornece apenas um sinal ADC experimental.
  O valor em kPa e uma simulacao baseada numa curva hipotetica, nao uma medicao
  de potencial matricial. Substitua essa curva por dados validados para o solo.
*/

// ---------- A. Aquisicao fisica ----------
const uint8_t SENSOR_ADC_PIN = 34;  // GPIO34: entrada ADC1 no ESP32 classico
const char *NOME_SENSOR = "FC28";   // Troque para "YL69" se aplicavel

// Opcional: pino EN de uma chave de carga/transistor externo.
// Deixe -1 para manter o modulo ligado. NAO alimente o modulo diretamente por GPIO.
const int SENSOR_ENABLE_PIN = -1;
const uint8_t SENSOR_ENABLE_ATIVO = HIGH;
const uint16_t TEMPO_ESTABILIZACAO_MS = 120;

const uint8_t NUM_AMOSTRAS_ADC = 16;
const uint16_t ESPACO_ENTRE_AMOSTRAS_MS = 3;
const uint32_t INTERVALO_LEITURA_MS = 5000;

// ---------- B. Calibracao e tratamento ----------
// Preencha com medias observadas na sua propria amostra seca e umida.
// -1 significa "ainda nao calibrado"; o JSON mostrara os indices como null.
const int RAW_SECO = -1;
const int RAW_UMIDO = -1;

// Inverte o indice calculado (100 - indice). Deixe false quando a calibracao
// RAW_SECO/RAW_UMIDO estiver preenchida com os endpoints corretos.
const bool INVERTER_POLARIDADE = false;

// ---------- C. Curva demonstrativa de potencial matricial ----------
// Pontos hipoteticos, ordenados por umidade crescente. Substituir por curva
// de retencao validada para o solo. Valores em kPa sao exclusivamente simulados.
struct PontoCurva {
  float umidadePct;
  float potencialKPa;
};

const PontoCurva CURVA_HIPOTETICA[] = {
    {0.0f, 150.0f}, {10.0f, 100.0f}, {20.0f, 60.0f}, {30.0f, 35.0f},
    {40.0f, 20.0f}, {50.0f, 10.0f},  {60.0f, 5.0f}};
const size_t NUM_PONTOS_CURVA = sizeof(CURVA_HIPOTETICA) / sizeof(CURVA_HIPOTETICA[0]);

// ---------- D. Analise e previsao demonstrativas ----------
// Ajuste estes limites conforme cultura, solo e validacao agronomica.
const float LIMIAR_ATENCAO_KPA = 30.0f;
const float LIMIAR_RISCO_KPA = 60.0f;
const float LIMITE_PREVISAO_KPA = 60.0f;

const uint8_t TAMANHO_HISTORICO = 36;  // 3 minutos a cada 5 segundos
const uint8_t MIN_AMOSTRAS_PREVISAO = 5;
const float TAXA_MINIMA_PREVISAO_KPA_H = 0.001f;

struct AmostraHistorico {
  float potencialKPa;
  uint32_t instanteMs;
};

AmostraHistorico historico[TAMANHO_HISTORICO];
uint8_t quantidadeHistorico = 0;
uint8_t proximaPosicaoHistorico = 0;

// ---------- Modo opcional sem sensor ----------
// true gera uma secagem artificial; nesse modo o ADC nao e lido.
const bool MODO_DEMO_SINTETICO = false;
const float DEMO_UMIDADE_INICIAL_PCT = 58.0f;
const float DEMO_QUEDA_PCT_POR_LEITURA = 0.5f;
float umidadeDemoPct = DEMO_UMIDADE_INICIAL_PCT;

// Esta versao sempre simula o potencial matricial. Ao integrar uma fonte real,
// altere a aquisicao e este indicador junto com a funcao de conversao.
const bool POTENCIAL_MATRICIAL_SIMULADO = true;

bool monitoramentoAtivo = true;
uint32_t ultimaLeituraMs = 0;
int rawAtual = -1;
float umidadeAtualPct = NAN;
float potencialAtualKPa = NAN;

// ---------- Declaracoes ----------
int lerRawMedioADC();
bool calibracaoValida();
float converterParaIndiceUmidade(int raw);
float simularPotencialMatricial(float umidadePct);
float calcularTaxaSecagem();
const char *classificarCondicaoHidrica(float potencialKPa);
bool estimarTempoAteLimite(float potencialAtualKPa, float taxaKPaH,
                           float &tempoHoras, const char *&motivo);
String gerarDadosJSON();
void processarComandosSerial();
void exibirAjuda();
void limparHistorico();
void registrarHistorico(float potencialKPa, uint32_t instanteMs);
void executarLeitura();
String numeroJSON(float valor, uint8_t casasDecimais);

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);  // ESP32 classico: 0..4095
  analogSetPinAttenuation(SENSOR_ADC_PIN, ADC_11db);

  if (SENSOR_ENABLE_PIN >= 0) {
    pinMode(SENSOR_ENABLE_PIN, OUTPUT);
    digitalWrite(SENSOR_ENABLE_PIN, !SENSOR_ENABLE_ATIVO);
  }

  Serial.println(F("# Agua no Ponto: kPa sempre simulado pela curva hipotetica."));
  Serial.println(F("# Digite H para ajuda; telemetria JSON a cada 5 s."));
}

void loop() {
  processarComandosSerial();

  const uint32_t agora = millis();
  if (monitoramentoAtivo && (uint32_t)(agora - ultimaLeituraMs) >= INTERVALO_LEITURA_MS) {
    ultimaLeituraMs = agora;
    executarLeitura();
  }
}

// ==================== A. Aquisicao fisica ====================

int lerRawMedioADC() {
  const bool controleExternoAtivo = SENSOR_ENABLE_PIN >= 0;
  if (controleExternoAtivo) {
    digitalWrite(SENSOR_ENABLE_PIN, SENSOR_ENABLE_ATIVO);
    delay(TEMPO_ESTABILIZACAO_MS);
  }

  uint32_t soma = 0;
  for (uint8_t i = 0; i < NUM_AMOSTRAS_ADC; ++i) {
    soma += (uint32_t)analogRead(SENSOR_ADC_PIN);
    if (i + 1 < NUM_AMOSTRAS_ADC) {
      delay(ESPACO_ENTRE_AMOSTRAS_MS);
    }
  }

  if (controleExternoAtivo) {
    digitalWrite(SENSOR_ENABLE_PIN, !SENSOR_ENABLE_ATIVO);
  }

  return (int)(soma / NUM_AMOSTRAS_ADC);
}

// ==================== B. Calibracao e tratamento ====================

bool calibracaoValida() {
  return RAW_SECO >= 0 && RAW_SECO <= 4095 && RAW_UMIDO >= 0 &&
         RAW_UMIDO <= 4095 && RAW_SECO != RAW_UMIDO;
}

float converterParaIndiceUmidade(int raw) {
  if (!calibracaoValida()) {
    return NAN;
  }

  // A formula aceita qualquer ordem dos endpoints e limita o indice a 0..100.
  float indice = 100.0f * ((float)raw - (float)RAW_SECO) /
                 ((float)RAW_UMIDO - (float)RAW_SECO);
  indice = constrain(indice, 0.0f, 100.0f);

  if (INVERTER_POLARIDADE) {
    indice = 100.0f - indice;
  }
  return indice;
}

// ==================== C. Simulacao do potencial matricial ====================

float simularPotencialMatricial(float umidadePct) {
  if (!isfinite(umidadePct)) {
    return NAN;
  }

  // Fora da tabela, limita ao endpoint mais proximo.
  if (umidadePct <= CURVA_HIPOTETICA[0].umidadePct) {
    return CURVA_HIPOTETICA[0].potencialKPa;
  }
  if (umidadePct >= CURVA_HIPOTETICA[NUM_PONTOS_CURVA - 1].umidadePct) {
    return CURVA_HIPOTETICA[NUM_PONTOS_CURVA - 1].potencialKPa;
  }

  for (size_t i = 0; i + 1 < NUM_PONTOS_CURVA; ++i) {
    const PontoCurva &a = CURVA_HIPOTETICA[i];
    const PontoCurva &b = CURVA_HIPOTETICA[i + 1];
    if (umidadePct >= a.umidadePct && umidadePct <= b.umidadePct) {
      const float fracao = (umidadePct - a.umidadePct) /
                           (b.umidadePct - a.umidadePct);
      return a.potencialKPa + fracao * (b.potencialKPa - a.potencialKPa);
    }
  }

  return NAN;  // Protecao caso a tabela seja configurada incorretamente.
}

// ==================== D. Analise e previsao demonstrativas ====================

void registrarHistorico(float potencialKPa, uint32_t instanteMs) {
  if (!isfinite(potencialKPa)) {
    return;
  }

  historico[proximaPosicaoHistorico].potencialKPa = potencialKPa;
  historico[proximaPosicaoHistorico].instanteMs = instanteMs;
  proximaPosicaoHistorico = (uint8_t)((proximaPosicaoHistorico + 1) % TAMANHO_HISTORICO);
  if (quantidadeHistorico < TAMANHO_HISTORICO) {
    ++quantidadeHistorico;
  }
}

void limparHistorico() {
  quantidadeHistorico = 0;
  proximaPosicaoHistorico = 0;
}

// Regressao linear de kPa em funcao do tempo, usando todo o historico disponivel.
// Retorna NaN ate haver pelo menos MIN_AMOSTRAS_PREVISAO pontos.
float calcularTaxaSecagem() {
  if (quantidadeHistorico < MIN_AMOSTRAS_PREVISAO) {
    return NAN;
  }

  const uint8_t indiceMaisAntigo =
      (uint8_t)((proximaPosicaoHistorico + TAMANHO_HISTORICO - quantidadeHistorico) %
                TAMANHO_HISTORICO);
  const uint32_t instanteInicial = historico[indiceMaisAntigo].instanteMs;

  double somaX = 0.0;
  double somaY = 0.0;
  double somaXX = 0.0;
  double somaXY = 0.0;

  for (uint8_t i = 0; i < quantidadeHistorico; ++i) {
    const uint8_t pos = (uint8_t)((indiceMaisAntigo + i) % TAMANHO_HISTORICO);
    // Subtracao unsigned tambem lida com o rollover de millis() neste intervalo curto.
    const uint32_t deltaMs = (uint32_t)(historico[pos].instanteMs - instanteInicial);
    const double xHoras = (double)deltaMs / 3600000.0;
    const double yKPa = (double)historico[pos].potencialKPa;
    somaX += xHoras;
    somaY += yKPa;
    somaXX += xHoras * xHoras;
    somaXY += xHoras * yKPa;
  }

  const double n = (double)quantidadeHistorico;
  const double denominador = n * somaXX - somaX * somaX;
  if (denominador <= 0.0) {
    return NAN;
  }

  const double inclinacaoKPaH = (n * somaXY - somaX * somaY) / denominador;
  return (float)inclinacaoKPaH;
}

const char *classificarCondicaoHidrica(float potencialKPa) {
  if (!isfinite(potencialKPa)) {
    return "CALIBRAR";
  }
  if (potencialKPa >= LIMIAR_RISCO_KPA) {
    return "RISCO";
  }
  if (potencialKPa >= LIMIAR_ATENCAO_KPA) {
    return "ATENCAO";
  }
  return "NORMAL";
}

bool estimarTempoAteLimite(float potencialAtual, float taxaKPaH,
                           float &tempoHoras, const char *&motivo) {
  tempoHoras = NAN;

  if (quantidadeHistorico < MIN_AMOSTRAS_PREVISAO || !isfinite(taxaKPaH)) {
    motivo = "dados_insuficientes";
    return false;
  }
  if (taxaKPaH <= TAXA_MINIMA_PREVISAO_KPA_H) {
    motivo = "taxa_nao_positiva";
    return false;
  }
  if (!isfinite(potencialAtual)) {
    motivo = "potencial_indisponivel";
    return false;
  }

  if (potencialAtual >= LIMITE_PREVISAO_KPA) {
    tempoHoras = 0.0f;
    motivo = "limite_ja_atingido";
    return true;
  }

  // kPa e kPa/h produzem horas. So previsao linear de demonstracao.
  tempoHoras = (LIMITE_PREVISAO_KPA - potencialAtual) / taxaKPaH;
  if (!isfinite(tempoHoras) || tempoHoras < 0.0f) {
    tempoHoras = NAN;
    motivo = "calculo_indisponivel";
    return false;
  }

  motivo = "previsao_demonstrativa";
  return true;
}

// ==================== E. Comunicacao JSON ====================

String numeroJSON(float valor, uint8_t casasDecimais) {
  if (!isfinite(valor)) {
    return "null";  // NaN e Infinity nao pertencem ao padrao JSON.
  }
  return String(valor, casasDecimais);
}

String gerarDadosJSON() {
  const float taxaKPaH = calcularTaxaSecagem();
  float tempoHoras = NAN;
  const char *motivoPrevisao = "dados_insuficientes";
  bool previsaoConfiavel = false;
  if (!MODO_DEMO_SINTETICO && !calibracaoValida()) {
    motivoPrevisao = "calibracao_invalida";
  } else {
    previsaoConfiavel = estimarTempoAteLimite(
        potencialAtualKPa, taxaKPaH, tempoHoras, motivoPrevisao);
  }

  String json;
  json.reserve(420);
  json += F("{\"sensor\":\"");
  json += NOME_SENSOR;
  json += F("\",\"tipo_medicao\":\"");
  json += MODO_DEMO_SINTETICO ? F("sintetica") : F("fisica");
  json += F("\",\"raw_adc\":");
  json += (rawAtual >= 0) ? String(rawAtual) : String("null");
  json += F(",\"umidade_indice_pct\":");
  json += numeroJSON(umidadeAtualPct, 1);
  json += F(",\"potencial_matricial_simulado_kpa\":");
  json += numeroJSON(potencialAtualKPa, 2);
  json += F(",\"taxa_secagem_simulada_kpa_h\":");
  json += numeroJSON(taxaKPaH, 3);
  json += F(",\"tempo_ate_limite_h\":");
  json += numeroJSON(tempoHoras, 2);
  json += F(",\"limite_previsao_kpa\":");
  json += numeroJSON(LIMITE_PREVISAO_KPA, 1);
  json += F(",\"estado\":\"");
  json += classificarCondicaoHidrica(potencialAtualKPa);
  json += F("\",\"previsao_confiavel\":");
  json += previsaoConfiavel ? F("true") : F("false");
  json += F(",\"motivo_previsao\":\"");
  json += motivoPrevisao;
  json += F("\",\"calibracao_valida\":");
  json += calibracaoValida() ? F("true") : F("false");
  json += F(",\"simulacao\":");
  json += POTENCIAL_MATRICIAL_SIMULADO ? F("true") : F("false");
  json += F(",\"curva_hipotetica\":");
  json += POTENCIAL_MATRICIAL_SIMULADO ? F("true") : F("false");
  json += F(",");
  json += F("\"previsao_demonstrativa\":true,\"uptime_s\":");
  json += String((uint32_t)(millis() / 1000));
  json += F("}");
  return json;
}

void executarLeitura() {
  const uint32_t agora = millis();

  if (MODO_DEMO_SINTETICO) {
    rawAtual = -1;
    umidadeDemoPct = max(0.0f, umidadeDemoPct - DEMO_QUEDA_PCT_POR_LEITURA);
    umidadeAtualPct = umidadeDemoPct;
  } else {
    rawAtual = lerRawMedioADC();
    umidadeAtualPct = converterParaIndiceUmidade(rawAtual);
  }

  potencialAtualKPa = simularPotencialMatricial(umidadeAtualPct);
  registrarHistorico(potencialAtualKPa, agora);
  Serial.println(gerarDadosJSON());
}

// ==================== Comandos pelo Monitor Serial ====================

void processarComandosSerial() {
  while (Serial.available() > 0) {
    String comando = Serial.readStringUntil('\n');
    comando.trim();
    if (comando.length() == 0) {
      continue;
    }

    const char c = (char)toupper((unsigned char)comando[0]);
    if (c == 'S') {
      monitoramentoAtivo = !monitoramentoAtivo;
      ultimaLeituraMs = millis();
      Serial.println(monitoramentoAtivo ? F("# Monitoramento iniciado.")
                                        : F("# Monitoramento interrompido."));
    } else if (c == 'R') {
      limparHistorico();
      if (MODO_DEMO_SINTETICO) {
        umidadeDemoPct = DEMO_UMIDADE_INICIAL_PCT;
      }
      ultimaLeituraMs = millis();
      if (MODO_DEMO_SINTETICO) {
        Serial.println(F("# Cenario sintetico reiniciado como apos irrigacao."));
      } else {
        Serial.println(F("# Historico reiniciado. Irrigue a amostra fisica para alterar a leitura."));
      }
    } else if (c == 'H') {
      exibirAjuda();
    } else {
      Serial.println(F("# Comando desconhecido. Digite H para ajuda."));
    }
  }
}

void exibirAjuda() {
  Serial.println(F("# Comandos: R reinicia historico/cenario; S inicia/para; H ajuda."));
  Serial.println(F("# A telemetria e JSON; linhas iniciadas com # sao mensagens de ajuda."));
  Serial.print(F("# Sensor: "));
  Serial.println(NOME_SENSOR);
  Serial.print(F("# ADC GPIO: "));
  Serial.println(SENSOR_ADC_PIN);
  Serial.print(F("# RAW_SECO / RAW_UMIDO: "));
  Serial.print(RAW_SECO);
  Serial.print(F(" / "));
  Serial.println(RAW_UMIDO);
  Serial.print(F("# Calibracao valida: "));
  Serial.println(calibracaoValida() ? F("sim") : F("nao"));
  Serial.print(F("# Modo sintetico: "));
  Serial.println(MODO_DEMO_SINTETICO ? F("sim") : F("nao"));
  Serial.print(F("# Limiares ATENCAO / RISCO / previsao (kPa simulados): "));
  Serial.print(LIMIAR_ATENCAO_KPA, 1);
  Serial.print(F(" / "));
  Serial.print(LIMIAR_RISCO_KPA, 1);
  Serial.print(F(" / "));
  Serial.println(LIMITE_PREVISAO_KPA, 1);
}
