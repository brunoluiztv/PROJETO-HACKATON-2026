# Caminhos relativos são resolvidos a partir de backend/, não do terminal atual.
DATABASE_PATH=data/monitoramento.sqlite3
SQLITE_TIMEOUT_SECONDS=5
# Limite inicial de idade da coleta; canal pode ter configuração específica no banco.
STALE_AFTER_SECONDS=300
# Para o celular, acrescente a origem exata informada pelo Vite (IP e porta).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preencher somente o chat autorizado; vazio mantém a fila sem entregar mensagens.
AUTHORIZED_TELEGRAM_CHAT_ID=
# URL acessível pelo celular na mesma LAN, por exemplo http://192.168.1.10:5173
DASHBOARD_URL=
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=10
