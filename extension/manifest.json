{
  "manifest_version": 3,
  "name": "AgroSponge RS — Acessibilidade",
  "description": "Aumenta o texto, melhora o contraste, ajuda quem tem dislexia e lê o site AgroSponge RS em voz alta.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://agrosponge-rs-uergs.netlify.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://agrosponge-rs-uergs.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Acessibilidade AgroSponge",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Abrir o painel de acessibilidade"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
